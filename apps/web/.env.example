# Copy this to .env (or .env.local) and fill in real values. Never commit the real file.
#
# Both point at the same Supabase Postgres instance used by other projects (e.g.
# pbandj) but select cwb-foundry's own "cwb_foundry" schema via ?schema=, so nothing
# here can collide with another app's tables.

# Pooled connection (PgBouncer, port 6543) — used by Prisma Client at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=cwb_foundry&pgbouncer=true"

# Direct connection (port 5432) — used for migrations (prisma db push / migrate).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=cwb_foundry"
