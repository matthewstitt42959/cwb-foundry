generator client {
  provider = "prisma-client-js"
}

// This Supabase project is shared with other apps (see pbandj). Everything here lives
// in its own "cwb_foundry" Postgres schema, selected via the ?schema= query param on
// DATABASE_URL/DIRECT_URL, so these tables can never collide with another app's.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Decklists saved from the menu's Import panel (replaces the hardcoded
/// SAVED_DECKLISTS array in GameApp.tsx). Plain decklist text only — the cards
/// themselves still come from Scryfall at import time, never stored here.
///
/// userId/ownerName come from a JWT issued by pbandj (see ../src/lib/auth.ts) —
/// there is no User table here. Null means an unowned "house" deck, visible and
/// loadable by everyone but not deletable by anyone without a matching userId.
model SavedDeck {
  id        String   @id @default(cuid())
  name      String
  text      String
  /// Free-text grouping label for the UI (e.g. "Rats") — not a hierarchy, not a
  /// separate table. Null/empty means ungrouped ("Unsorted" in the UI).
  folder    String?
  /// Defaults to private (visible only to its owner) for new decks. Unowned
  /// "house" decks are always effectively public regardless of this flag, since
  /// there's no owner to keep them private from.
  public    Boolean  @default(false)
  userId    String?
  ownerName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
